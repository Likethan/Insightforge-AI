# ─────────────────────────────────────────────────────────
#  InsightForge AI — Environment Variable Template
#  Copy this file to .env and fill in your values:
#    Windows: copy .env.example .env
#    macOS/Linux: cp .env.example .env
# ─────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com
GOOGLE_API_KEY="your_google_ai_studio_api_key_here"

# ── Model Selection ────────────────────────────────────────
# Options: gemini-2.0-flash | gemini-2.5-flash | gemini-2.5-pro
GEMINI_MODEL_VERSION="gemini-2.0-flash"

# ── Optional: LangSmith Tracing ───────────────────────────
# Enable for agent execution tracing at smith.langchain.com
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY="your_langchain_api_key_here"
LANGCHAIN_PROJECT="InsightForge_Agent"

# ── Optional: Ollama Local Model Fallback ─────────────────
OLLAMA_BASE_URL="http://localhost:11434"
